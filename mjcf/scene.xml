<mujoco model="cr5 pick and place">
  <!-- The robot (CR5 + Robotiq 2F-85) is generated by tools/build_mujoco_model.py. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <statistic center="-0.3 0 0.3" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <asset>
    <model name="cr5" file="cr5.xml"/>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <attach model="cr5" body="base_link" prefix=""/>

    <!-- Static obstacles. The planner reads every box geom named obs_* as a collision cuboid. -->
    <geom name="obs_table" type="box" pos="-0.45 0 0.075" size="0.2 0.3 0.075" rgba="0.55 0.4 0.3 1"/>
    <geom name="obs_wall" type="box" pos="-0.45 0 0.21" size="0.015 0.2 0.06" rgba="0.8 0.3 0.3 0.8"/>

    <!-- Place target behind the wall (visual only). -->
    <site name="place_target" type="box" pos="-0.57 0.12 0.1505" size="0.03 0.03 0.0005" rgba="0.2 0.4 1 0.6"/>

    <!-- Object to pick, in front of the wall. -->
    <body name="cube" pos="-0.33 0.12 0.17">
      <freejoint name="cube"/>
      <geom name="cube" type="box" size="0.02 0.02 0.02" rgba="0.2 0.7 0.3 1" mass="0.05" friction="1 0.01 0.001"/>
    </body>
  </worldbody>
</mujoco>
